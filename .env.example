# Database
DATABASE_URL=postgresql://nimnegah:changeme@localhost:5432/nimnegah
DB_PASSWORD=changeme

# Connection pool + query guards (optional — defaults are safe)
# Keep DB_POOL_MAX well below Postgres max_connections (100).
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=changeme

# Payload CMS
PAYLOAD_SECRET=changeme-payload-secret-32chars-min

# sms.ir
SMSIR_API_KEY=your-smsir-api-key
SMSIR_LINE_NUMBER=30007732000000
SMSIR_TEMPLATE_ID=12345

# Zarinpal
ZARINPAL_MERCHANT_ID=your-merchant-id
ZARINPAL_SANDBOX=true

# SpotPlayer
SPOTPLAYER_API_KEY=your-spotplayer-api-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=changeme-jwt-secret-32chars-min

# Digital product download links (signed URLs)
# Falls back to PAYLOAD_SECRET when unset
DOWNLOAD_TOKEN_SECRET=changeme-download-secret-32chars-min
# Link validity in minutes (default 360 = 6 hours)
DOWNLOAD_LINK_TTL_MINUTES=360

# How long a resolved "is this purchase allowed" decision is cached.
# The download route would otherwise run 3 DB queries per request, which
# saturates the connection pool when many people download at once.
# Set to 0 to disable the cache. Default 60 seconds.
DOWNLOAD_AUTHZ_CACHE_SECONDS=60

# Maximum number of requests a single download link may make per 5 minutes.
# Range/resume requests count too, so keep this comfortably above the number
# of chunks a browser needs. Default 30.
DOWNLOAD_MAX_REQUESTS_PER_TOKEN=30

# Let Nginx serve the product file straight from disk (X-Accel-Redirect).
# Requires the matching `location /protected-files/` block in docker/nginx.conf.
# Leave false when running without Nginx (e.g. local dev) — the app then
# streams the file itself, which still works, just less efficiently.
DOWNLOAD_X_ACCEL_ENABLED=false
# Internal URI prefix Nginx exposes for the protected files.
DOWNLOAD_X_ACCEL_PATH=/protected-files/
